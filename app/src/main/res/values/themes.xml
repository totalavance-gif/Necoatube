        <item name="android:statusBarColor">@color/yt_bg</item>
        <item name="android:navigationBarColor">@color/yt_bg</item>
        <item name="colorPrimary">@color/yt_red</item>
        <item name="android:textColorPrimary">@color/yt_text</item>
        <item name="android:textColorSecondary">@color/yt_text2</item>
        <item name="ytBg">@color/yt_bg</item>
        <item name="ytSurface">@color/yt_surface</item>
        <item name="ytChip">@color/yt_chip</item>
